# Local development template — copy to `.env` and fill in real values.
# Never commit `.env` (see root .gitignore).

# PostgreSQL — skeleton database (ADR-056/183/184): clone source + tenant registry. Prisma CLI
# (migrate/generate) always targets this; every other tenant connection is resolved dynamically at
# request time from TenantRegistry rows, not from an env var.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lbm_erp_skeleton?schema=public"
# First local tenant, seeded into TenantRegistry — not read by the app directly, only by the local
# seed script (`prisma/seed.ts`, T-022) that inserts its TenantRegistry row.
DEMO_TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lbm_erp_dev?schema=public"

# CORS — locked to the project's own frontend origin(s) only (ADR-176), comma-separated.
CORS_ORIGIN="http://localhost:3001"

# JWT auth (see 3-api/2-authentication.md)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Redis (BullMQ queue + cache)
REDIS_URL="redis://localhost:6379"

# AWS S3 (file storage — local dev may point at a real dev-tier bucket or a local
# S3-compatible service; see 1-project/4-tech-stack.md §7)
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
